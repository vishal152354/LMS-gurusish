# Copy to viva-webapp/.env and fill in. Never commit .env.

# ── LLM (any OpenAI-compatible API) ──────────────────────────
# OpenRouter:
HERMES_API_URL=https://openrouter.ai/api/v1
HERMES_MODEL=google/gemini-2.5-flash
HERMES_API_KEY=sk-or-v1-your-key-here
HERMES_API_TIMEOUT=75
# Local Ollama instead:
# HERMES_API_URL=http://localhost:11434/v1
# HERMES_MODEL=qwen2.5:3b
# HERMES_API_KEY=ollama

# ── Professor login (applied when the database is first created) ──
PROFESSOR_USERNAME=admin
PROFESSOR_PASSWORD=change-me

# ── Session token signing — set a long random value ──
TOKEN_SECRET=change-me-to-a-long-random-string

# ── Optional: email invites to rostered students ──
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_ADDRESS=you@example.com
# EMAIL_PASSWORD=app-password
# APP_URL=http://localhost:7860

# ── Optional: Ollama Cloud fallback ──
# OLLAMA_API_KEY=
