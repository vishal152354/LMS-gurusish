# Production build. On Vercel, set VITE_API_BASE_URL in Project → Settings →
# Environment Variables — it overrides the value here.
VITE_APP_ENV=production
VITE_API_BASE_URL=https://api.pariksha.example.edu
# Empty = no live notifications (the backend doesn't emit any yet)
VITE_SOCKET_URL=
VITE_IDLE_TIMEOUT_MINUTES=20
